// Tobi's Towhee deployment at https://towhee.madebytobi.com: the website and live demo (apps/site),
// and the Towhee server (wss://towhee.madebytobi.com/v1/...).
// Deploy from the repo root:  pnpm install && pnpm build && pnpm --filter @towhee/deploy-cloudflare deploy
// Secrets: TOWHEE_KEYS = [{"id":"default","secret":...},{"id":"demo","secret":...,"rooms":"demo:*"}]
{
  "name": "towhee",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [
      { "name": "TOWHEE_ROOMS", "class_name": "TowheeRoom" },
      { "name": "TOWHEE_INBOXES", "class_name": "TowheeInbox" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["TowheeRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["TowheeInbox"] }
  ],
  // The site's files are served directly; these paths run the Worker instead. Anything else that
  // isn't a file gets index.html, so client-side routes like /docs/client load on refresh.
  "assets": {
    "directory": "../../apps/site/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/v1/*", "/health", "/demo/token"]
  },
  // Demo boards are wiped a day after they're created, once nobody is on them.
  // Junco's docs editor (and its local dev server) use the demo token endpoint too.
  "vars": {
    "TOWHEE_EXPIRE_ROOMS": "demo:*",
    "TOWHEE_EXPIRE_AFTER_HOURS": "24",
    "DEMO_ORIGINS": "https://junco.madebytobi.com,http://localhost:3000"
  },
  "ratelimits": [{ "name": "DEMO_LIMITER", "namespace_id": "4102", "simple": { "limit": 30, "period": 60 } }],
  // Cloudflare creates the DNS record and certificate for the custom domain.
  "routes": [{ "pattern": "towhee.madebytobi.com", "custom_domain": true }],
  "workers_dev": false,
  "observability": { "enabled": true }
}
