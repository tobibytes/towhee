{
  "name": "@towhee/core",
  "version": "0.2.0",
  "description": "The Towhee engine: rooms with Yjs sync and presence, comments, version history, inboxes and webhooks over any transport and storage.",
  "license": "MIT",
  "author": "Oluwatobi Olajide",
  "homepage": "https://towhee.madebytobi.com",
  "bugs": {
    "url": "https://github.com/tobibytes/towhee/issues"
  },
  "keywords": [
    "realtime",
    "collaboration",
    "yjs",
    "presence",
    "comments"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@towhee/auth": "workspace:*",
    "@towhee/protocol": "workspace:*",
    "lib0": "^0.2.119",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobibytes/towhee.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  }
}
