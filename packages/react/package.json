    "@towhee/protocol": "workspace:*",
    "yjs": "^13.6.33"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@testing-library/react": "^16",
    "@towhee/auth": "workspace:*",
    "@towhee/core": "workspace:*",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jsdom": "^26",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobibytes/towhee.git",
    "directory": "packages/react"
  },
  "publishConfig": {
    "access": "public"
  }
