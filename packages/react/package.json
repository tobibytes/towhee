{
  "name": "@towhee/react",
  "version": "0.1.0",
  "description": "React hooks for Towhee: rooms, presence, status, threads, history and the inbox.",
  "license": "MIT",
  "author": "Oluwatobi Olajide",
  "homepage": "https://towhee.madebytobi.com",
  "bugs": {
    "url": "https://github.com/tobibytes/towhee/issues"
  },
  "keywords": [
    "realtime",
    "collaboration",
    "react",
    "hooks",
    "presence",
    "multiplayer"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
