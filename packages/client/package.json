{
  "name": "@towhee/client",
  "version": "0.1.2",
  "description": "Connect to Towhee from the browser or Node: a synced Y.Doc, presence, comments, version history and an inbox, with reconnects and offline edits.",
  "license": "MIT",
  "author": "Oluwatobi Olajide",
  "homepage": "https://towhee.madebytobi.com",
  "bugs": {
    "url": "https://github.com/tobibytes/towhee/issues"
  },
  "keywords": [
    "realtime",
    "collaboration",
    "yjs",
    "websocket",
    "presence",
    "multiplayer"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@towhee/protocol": "workspace:*",
    "lib0": "^0.2.119",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@towhee/auth": "workspace:*",
    "@towhee/core": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobibytes/towhee.git",
    "directory": "packages/client"
  },
  "publishConfig": {
    "access": "public"
  }
}
