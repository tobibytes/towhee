{
  "name": "@towhee/cloudflare",
  "version": "0.2.0",
  "description": "Run the Towhee server on Cloudflare: a Worker plus Durable Objects per room and inbox, with WebSocket hibernation and SQLite.",
  "license": "MIT",
  "author": "Oluwatobi Olajide",
  "homepage": "https://towhee.madebytobi.com",
  "bugs": {
    "url": "https://github.com/tobibytes/towhee/issues"
  },
  "keywords": [
    "realtime",
    "collaboration",
    "yjs",
    "cloudflare",
    "durable-objects",
    "workers"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "template"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@towhee/auth": "workspace:*",
    "@towhee/core": "workspace:*",
    "@towhee/protocol": "workspace:*",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261027.1",
    "@towhee/client": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobibytes/towhee.git",
    "directory": "packages/cloudflare"
  },
  "publishConfig": {
    "access": "public"
  }
}
