// Deploy Towhee to your Cloudflare account:
//   npm install
//   npx wrangler secret put TOWHEE_SECRET   # a random string of at least 32 characters
//   npx wrangler deploy
// Clients connect to wss://<your-worker>.<your-subdomain>.workers.dev (or a custom domain).
{
  "name": "towhee",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [
      { "name": "TOWHEE_ROOMS", "class_name": "TowheeRoom" },
      { "name": "TOWHEE_INBOXES", "class_name": "TowheeInbox" }
    ]
  },
  // new_sqlite_classes: rooms and inboxes keep their data in Durable Object SQLite.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["TowheeRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["TowheeInbox"] }
  ],
  "vars": {
    // Optional: POST each notification to your app (also `wrangler secret put TOWHEE_WEBHOOK_SECRET`).
    // "TOWHEE_WEBHOOK_URL": "https://your-app.example/api/towhee-webhook",
    // Optional: wipe throwaway rooms a day after they're created, once nobody is in them.
    // "TOWHEE_EXPIRE_ROOMS": "demo:*",
    // "TOWHEE_EXPIRE_AFTER_HOURS": "24",
    // Optional limits (defaults in parentheses):
    // "TOWHEE_MAX_CONNECTIONS": "100",
    // "TOWHEE_MAX_MESSAGE_BYTES": "1048576",
    // "TOWHEE_MAX_DOCUMENT_BYTES": "52428800"
  },
  "observability": { "enabled": true }
}
