{
  "name": "@towhee/auth",
  "version": "0.1.1",
  "description": "Sign Towhee room and inbox tokens in your backend, and verify Towhee webhooks. WebCrypto only: Node, Workers, Deno and Bun.",
  "license": "MIT",
  "author": "Oluwatobi Olajide",
  "homepage": "https://towhee.madebytobi.com",
  "bugs": {
    "url": "https://github.com/tobibytes/towhee/issues"
  },
  "keywords": [
    "realtime",
    "collaboration",
    "jwt",
    "tokens"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@towhee/protocol": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobibytes/towhee.git",
    "directory": "packages/auth"
  },
  "publishConfig": {
    "access": "public"
  }
}
