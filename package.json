{
  "name": "towhee",
  "private": true,
  "description": "Self-hosted realtime collaboration engine: presence, Yjs shared state, comments, history and notifications on Cloudflare or Node.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome lint .",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "node scripts/publish.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "^2.27.0",
    "@cloudflare/vitest-plugin": "^1.4.8",
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0",
    "turbo": "^2.3.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.0"
  }
}
